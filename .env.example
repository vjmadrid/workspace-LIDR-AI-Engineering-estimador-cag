# ============================================
# Environment Variables
# ============================================
# Template file with all required environment variables
# Copy this file to .env and fill in the actual values

# =====================
# General Settings
# =====================

# Application name
APP_NAME=estimador-cag

# Application environment
# Options: development, production, test
APP_ENV=development

# Logging level for the application
# Options: error, warn, info, debug
LOG_LEVEL=debug

# =====================
# LLM Settings
# =====================

# LLM Provider to use for generating responses
# Options: openai, anthropic
LLM_PROVIDER=openai

# OpenAI API Key
# Required for authentication with OpenAI services
# Obtain your key at: https://platform.openai.com/account/api-keys
# Format: sk-...l
OPENAI_API_KEY=

# Anthropic API Key
# Required for authentication with Anthropic services
# Obtain your key at: https://platform.claude.com/settings/keys
# Format: sk-...
ANTHROPIC_API_KEY=

# LLM Model to use for generating responses (OpenAI)
# Options: gpt-4o-mini, gpt-4o, gpt-4, gpt-3.5-turbo
LLM_MODEL_OPENAI=gpt-4o-mini

