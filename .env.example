# ============================================
# Environment Variables
# ============================================
# Template file with all required environment variables
# Copy this file to .env and fill in the actual values

# =====================
# General Settings
# =====================

# Host for the backend service to listen on
SERVICE_HOST=0.0.0.0

# Port for the backend service to listen on
SERVICE_PORT=8000

# Application name
APP_NAME=estimador-cag

# Application environment
# Options: development, production, test
APP_ENV=development

# Logging level for the application
# Options: error, warn, info, debug
LOG_LEVEL=debug

# =====================
# LLM Settings
# =====================

# LLM Provider to use for generating responses
# Options: openai, anthropic
LLM_PROVIDER=openai

# OpenAI API Key
# Required for authentication with OpenAI services
# Obtain your key at: https://platform.openai.com/account/api-keys
# Format: sk-...l
OPENAI_API_KEY=

# LLM Model to use for generating responses (OpenAI)
# Options: gpt-4o-mini, gpt-4o, gpt-4, gpt-3.5-turbo, etc.
OPENAI_MODEL=gpt-4o-mini

# Anthropic API Key
# Required for authentication with Anthropic services
# Obtain your key at: https://platform.claude.com/settings/keys
# Format: sk-...
ANTHROPIC_API_KEY=

# LLM Model to use for generating responses (Anthropic)
# Options: claude-haiku-4-5-20251001, claude-sonnet-4-6-20250514, etc.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# =====================
# Streamlit Frontend Settings
# =====================

# Backend URL used by the Streamlit app
ESTIMATE_BACKEND_BASE_URL=http://127.0.0.1:${SERVICE_PORT}

# Timeout in seconds for Streamlit requests to the backend
ESTIMATE_BACKEND_TIMEOUT_SECONDS=120